# Copy to .env.local and restart `npm start`.

# Main REST API
REACT_APP_API_BASE_URL=https://api-test.qarshidu.uz

# Camera / streaming service (defaults to API base)
REACT_APP_CAM_API_BASE_URL=https://api-test.qarshidu.uz

# Model / inference service (defaults to API base)
REACT_APP_MODEL_API_BASE_URL=https://api-test.qarshidu.uz

# WebSocket for live cache invalidation (auto-derived from API URL if omitted)
REACT_APP_WS_URL=wss://api-test.qarshidu.uz/ws/
